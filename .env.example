# ---- Browser-safe config (NEXT_PUBLIC_* is exposed to the browser) ----
# Local development default: Hardhat node at http://127.0.0.1:8545, chain 31337.
# For Sepolia, set this to YOUR Sepolia RPC endpoint and chain 11155111.
NEXT_PUBLIC_RPC_URL=YOUR_SEPOLIA_RPC_URL
NEXT_PUBLIC_CHAIN_ID=11155111

# Contract addresses from your deployment (see deployments/*.json).
NEXT_PUBLIC_IDENTITY_ADDR=YOUR_IDENTITY_REGISTRY_ADDRESS
NEXT_PUBLIC_ACCESS_ADDR=YOUR_ACCESS_MANAGER_ADDRESS
NEXT_PUBLIC_ASSET_ADDR=YOUR_ASSET_REGISTRY_ADDRESS

# Optional: public Spline 3D scene URL for the landing hero. Leave empty for the fallback panel.
# NEXT_PUBLIC_SPLINE_SCENE=

# ---- Deployment-only (server side, NEVER prefix with NEXT_PUBLIC_, never commit) ----
# Used by hardhat.config.ts for Sepolia deploys only. Use a dedicated throwaway key.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
